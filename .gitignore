# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local editor backups
# e.g. functions.php-bk07212026, custom-service.js--bk07022026,
#       functions.php.bak-20260805-114756
*-bk[0-9]*
*--bk[0-9]*
*.bak
*.bak-*
*.bak.*
*.orig
*.old
*.save
*~

# Logs
*.log

# Composer dev dependencies (run `composer install` locally; dev-only tooling)
/vendor/
**/vendor/

# Beanstalk development and test tooling (production theme files only)
wp-content/themes/bricks/beanstalk/tests/
wp-content/themes/bricks/beanstalk/tools/
wp-content/themes/bricks/beanstalk/composer.json
wp-content/themes/bricks/beanstalk/composer.lock
wp-content/themes/bricks/beanstalk/phpunit.xml.dist
wp-content/themes/bricks/beanstalk/phpcs.xml.dist
wp-content/themes/bricks/beanstalk/TESTING.md
wp-content/themes/bricks/beanstalk/.phpunit.result.cache

# Beanstalk Content Engine development files (runtime plugin files only)
wp-content/plugins/beanstalk-content-engine/tests/
wp-content/plugins/beanstalk-content-engine/docs/
wp-content/plugins/beanstalk-content-engine/vendor/
wp-content/plugins/beanstalk-content-engine/composer.json
wp-content/plugins/beanstalk-content-engine/composer.lock
wp-content/plugins/beanstalk-content-engine/phpcs.xml.dist
wp-content/plugins/beanstalk-content-engine/.phpunit.result.cache

# Claude Code local settings (personal, not shared)
.claude/settings.local.json

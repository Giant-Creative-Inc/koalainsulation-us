{
    "name": "koala/gravity-integration",
    "type": "wordpress-plugin",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": [
            "phpcs --standard=WordPress includes/ koala-gravity-integration.php",
            "phpcs --standard=WordPress-Extra includes/ koala-gravity-integration.php",
            "phpcs --standard=WordPress-Docs includes/ koala-gravity-integration.php"
        ],
        "lint:fix": "phpcbf --standard=WordPress includes/ koala-gravity-integration.php",
        "test": "@test:routing",
        "test:routing": "php tests/zip-radius-regression.php",
        "test:attribution": "node tests/attribution.test.js",
        "test:all": [
            "@test:routing",
            "@test:attribution",
            "@test:assets"
        ],
        "test:assets": "php tests/form-assets-regression.php"
    }
}
